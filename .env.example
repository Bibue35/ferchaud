# ══════════════════════════════════════════════════════════════════════════════
#  QuantBot v2 — Master Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ── Alpaca API ────────────────────────────────────────────────────────────────
# Get free keys at https://alpaca.markets
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Trading mode: "paper" or "live"
TRADING_MODE=paper

# ── Risk Parameters ───────────────────────────────────────────────────────────
MAX_PORTFOLIO_RISK=0.02          # Max 2% of portfolio at risk per trade
MAX_DRAWDOWN=0.15                # Halt ALL trading if drawdown exceeds 15%
MAX_POSITION_SIZE=0.10           # Max 10% of portfolio in a single position
KELLY_FRACTION=0.25              # Fractional Kelly (25%) for conservative sizing
VAR_CONFIDENCE=0.99              # Value-at-Risk confidence level
VOL_TARGET=0.12                  # Target annualized portfolio volatility (12%)
VOL_LOOKBACK=60                  # Days for volatility estimation
MAX_LEVERAGE=2.0                 # Hard leverage cap for vol-targeting
MIN_LEVERAGE=0.25                # Floor — never go below 25% invested
MAX_CORRELATION=0.85             # Warn if cross-strategy correlation exceeds this

# ── Regime Detection (HMM) ──────────────────────────────────────────────────
REGIME_ENABLED=true
REGIME_STATES=3                  # 2 = bull/bear, 3 = bull/sideways/crisis
REGIME_LOOKBACK=504              # Training window in days (~2 years)
REGIME_RETRAIN_DAYS=21           # Retrain HMM monthly
REGIME_MARKET_PROXY=SPY          # Symbol used for market regime detection
REGIME_CRISIS_SCALE=0.3          # Scale position sizes to 30% in crisis regime

# ── VPIN Toxicity Monitor ────────────────────────────────────────────────────
VPIN_ENABLED=true
VPIN_BUCKET_FRACTION=0.02        # Volume bucket = 2% of 20-day ADV
VPIN_WINDOW=50                   # Number of buckets for VPIN calculation
VPIN_HALT_THRESHOLD=0.85         # Halt new entries when VPIN CDF > 85th pct

# ── Strategy Enable/Disable ──────────────────────────────────────────────────
STRATEGY_MEAN_REVERSION=true
STRATEGY_MOMENTUM=true
STRATEGY_STAT_ARB=true
STRATEGY_MARKET_MAKING=false     # Needs L2 data — disable by default
STRATEGY_MULTI_FACTOR=true       # ML-boosted multi-factor alpha

# ── Strategy Weights (risk-parity override) ──────────────────────────────────
# If set, override risk-parity with fixed weights (must sum to 1.0)
# Leave commented for automatic risk-parity allocation
# STRATEGY_WEIGHT_MEAN_REVERSION=0.25
# STRATEGY_WEIGHT_MOMENTUM=0.25
# STRATEGY_WEIGHT_STAT_ARB=0.25
# STRATEGY_WEIGHT_MULTI_FACTOR=0.25

# ── Universe ──────────────────────────────────────────────────────────────────
STOCK_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,SPY,QQQ,AMD,JPM,V,UNH,XOM,LLY
CRYPTO_UNIVERSE=BTC/USD,ETH/USD,SOL/USD,AVAX/USD

# Stat-arb pairs (pipe-separated pairs, comma-separated symbols in each pair)
STAT_ARB_PAIRS=AAPL,MSFT|SPY,QQQ|BTC/USD,ETH/USD|XOM,CVX|JPM,GS

# ── Execution ─────────────────────────────────────────────────────────────────
ORDER_TYPE=smart                 # market | limit | smart | twap | vwap
SLIPPAGE_TOLERANCE=0.001         # 0.1% slippage tolerance for limit orders
MAX_RETRIES=3
TWAP_SLICES=5                   # Number of time slices for TWAP
TWAP_INTERVAL_SEC=30            # Seconds between TWAP slices
VWAP_PARTICIPATION=0.10         # Target 10% of volume for VWAP execution

# ── Backtesting ───────────────────────────────────────────────────────────────
BACKTEST_ENABLED=false           # Set true to run backtest instead of live
BACKTEST_START=2023-01-01
BACKTEST_END=2025-12-31
BACKTEST_IS_WINDOW=252           # In-sample window (trading days)
BACKTEST_OOS_WINDOW=63           # Out-of-sample window (trading days)
BACKTEST_INITIAL_CAPITAL=100000

# ── ML Model ─────────────────────────────────────────────────────────────────
ML_RETRAIN_DAYS=30               # Retrain LightGBM monthly
ML_MIN_SAMPLES=500               # Minimum samples before ML predictions
ML_PURGE_DAYS=5                  # Purge window for walk-forward CV
ML_N_FEATURES=25                 # Max features to keep after selection
